# Where the site lives (used in emails and Stripe redirects)
NEXT_PUBLIC_URL=https://oxyra.org

# Stripe: use test keys until you're ready to take real money
STRIPE_SECRET_KEY=sk_test_...
# From Stripe → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# Order database (Supabase → Project settings → API keys)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# CJ Dropshipping (CJ → My CJ → Authorization → API → API Key)
CJ_API_KEY=
# The CJ product variant to order. Copy the SKU from the CJ product page.
CJ_VARIANT_SKU=CJJJCFHS00663-Silver Upgraded
# Shipping method to use when available (comma-separated, first match wins); otherwise the cheapest.
CJ_PREFERRED_SHIPPING=CJPacket Sensitive
# Orders whose CJ shipping costs more than this (USD) wait for you instead of being sent automatically.
CJ_MAX_SHIPPING_USD=45
# Email you when the CJ wallet drops below this (USD).
CJ_LOW_BALANCE_USD=150
# 1 = send orders to CJ as sandbox orders (no real charge). Remove for real orders.
CJ_SANDBOX=1

# Email (Resend). EMAIL_FROM must use a domain you've verified in Resend.
RESEND_API_KEY=re_...
EMAIL_FROM=Oxyra <orders@oxyra.org>
# Where alerts about problem orders go
ADMIN_EMAIL=you@example.com

# Password for /admin. Required; there is no default.
ADMIN_SECRET=choose-a-long-random-password
# Any long random string; Vercel uses it to run the daily check
CRON_SECRET=another-long-random-string

# Visit counts for /admin/analytics (optional)
KV_REST_API_URL=
KV_REST_API_TOKEN=
